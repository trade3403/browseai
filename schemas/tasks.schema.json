{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browseai.invalid/schemas/tasks.schema.json",
  "title": "BrowseAI Git control tasks",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "dependencies",
          "instruction",
          "acceptance"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "protocol_version",
    "task_id",
    "stages"
  ]
}
