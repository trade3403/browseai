{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browseai.invalid/schemas/result.schema.json",
  "title": "BrowseAI Git control result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stage_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "code_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "commit",
              "pull_request",
              "workflow_run",
              "artifact"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/(commit/[0-9a-f]{40}|pull/[1-9][0-9]*|actions/runs/[1-9][0-9]*(/artifacts/[1-9][0-9]*)?)$"
          }
        },
        "required": [
          "kind",
          "url"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "protocol_version",
    "task_id",
    "revision",
    "stage_id",
    "code_sha",
    "dispatch_id",
    "evidence",
    "updated_at"
  ]
}
